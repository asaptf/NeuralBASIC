# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Agent worktrees are full checkouts nested inside the repo. Untracked they are
# a footgun: `git add -A` records one as a gitlink with no .gitmodules entry and
# an absolute path only this machine has, which no other clone can reconstruct.
/.claude/worktrees/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# One-off scaffolding scripts left over from project generation. Unreferenced by
# package.json, and they hardcode an absolute path into a local temp directory,
# so they are kept locally but not published.
/scripts/

